    from profilesync.sync import main as _profiles_main
    return _profiles_main(["run"] + args)


def hooks_sync(args):
    from hooksync.sync import main as _hooks_main
    return _hooks_main(["sync"] + args)


def hooks_list(args):
    from hooksync.sync import main as _hooks_main
    return _hooks_main(["list"] + args)


COMMANDS = {
    "start": start, "stop": stop, "restart": restart, "status": status,
    "tail": tail, "reap": reap, "mcp-cost": mcp_cost, "test": selftest, "install-agent": install_agent,
    "uninstall-agent": uninstall_agent,
    "hooks-sync": hooks_sync, "hooks-list": hooks_list,
    "skills-sync": skills_sync, "skills-list": skills_list,
    "instructions-sync": instructions_sync, "instructions-list": instructions_list,
    "instructions-show": instructions_show,
    "profiles-sync": profiles_sync, "profiles-list": profiles_list, "profile": profile,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print("usage: govctl {" + " | ".join(COMMANDS) + "} [args]", file=sys.stderr)
        return 2
    return COMMANDS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    sys.exit(main())
