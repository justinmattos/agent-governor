#!/usr/bin/env python3
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)
SERVER = os.path.join(ROOT, "govd", "server.py")
HOME = os.path.expanduser(os.environ.get("GOVD_HOME", "~/.govd"))
PORT_FILE = os.path.join(HOME, "port")
PID_FILE = os.path.join(HOME, "govd.pid")
AUDIT_FILE = os.path.join(HOME, "audit.jsonl")
OUT_LOG = os.path.join(HOME, "govd.out.log")
from govd.config import LAUNCH_AGENT_LABEL as LABEL, LAUNCH_AGENT_PLIST as PLIST


def _port():
    if os.environ.get("GOVD_PORT"):
        return int(os.environ["GOVD_PORT"])
    try:
        with open(PORT_FILE) as fh:
            return int(fh.read().strip())
    except Exception:
        return 8787


def _health():
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{_port()}/v1/health", timeout=2) as r:
            return json.loads(r.read())
    except Exception:
        return None


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _pid():
    try:
        with open(PID_FILE) as fh:
            return int(fh.read().strip())
    except Exception:
        return None


def start(_):
    if _health():
        print("govd already running on port", _port())
        return 0
    os.makedirs(HOME, exist_ok=True)
    log = open(OUT_LOG, "a")
    subprocess.Popen(
        [sys.executable, SERVER], stdout=log, stderr=log, start_new_session=True
    )
    for _ in range(20):
        time.sleep(0.2)
        if _health():
            print("govd started on port", _port())
            return 0
    print("govd failed to start; see", OUT_LOG, file=sys.stderr)
    return 1


def stop(_):
    pid = _pid()
    if pid and _alive(pid):
        os.kill(pid, signal.SIGTERM)
        print("stopped govd pid", pid)
        if os.path.exists(PLIST):
            print("note: LaunchAgent is installed and will restart govd — run 'govctl uninstall-agent' to stop for good")
        return 0
    print("govd not running")
    return 0


def restart(args):
    stop(args)
    time.sleep(0.5)
    return start(args)


def status(_):
    h = _health()
    if not h:
        print("govd: NOT running (port", _port(), ")")
    else:
        print(f"govd: running  pid={h['pid']} port={_port()} uptime={h['uptime_seconds']}s v{h['version']}")
        print("rules:", ", ".join(h["rules"]))
        r = h.get("reaper") or {}
        if r.get("enabled"):
            last = time.strftime("%H:%M:%S", time.localtime(r["last_run"])) if r.get("last_run") else "not yet"
            print(f"reaper: every {r['interval_seconds']}s for {', '.join(r['patterns'])}; "
                  f"last scan {last}; reaped {r['groups_reaped']} orphan group(s), {r['rss_reaped_mb']} MB since start")
        else:
            print("reaper: disabled")
    print("launchagent:", "installed" if os.path.exists(PLIST) else "not installed")
    print("audit log:", AUDIT_FILE)
    return 0


_CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f\u2028\u2029\u202a-\u202e\u2066-\u2069]")


def _clean(text):
    return _CONTROL.sub("", text)


def tail(args):
    n = int(args[0]) if args else 20
    try:
        with open(AUDIT_FILE) as fh:
            lines = fh.readlines()[-n:]
    except FileNotFoundError:
        print("no audit log yet")
        return 0
    for line in lines:
        try:
            e = json.loads(line)
        except Exception:
            continue
        mark = {"deny": "DENY", "block": "BLOCK", "ask": "ASK ", "reap": "REAP"}.get(e.get("decision"), "ok  ")
        print(_clean(f"{e.get('ts', '')[11:19]} {mark} {e.get('agent', ''):11} {e.get('event', ''):16} {e.get('target', '')[:70]}"))
    return 0


SAMPLES = [
    ("benign shell", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "ls"}}, "allow"),
    ("rm -rf /", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "rm -rf /"}}, "deny"),
    ("junk comment", {"agent": "t", "event": "post_tool_use", "tool": "file_edit",
                       "input": {"file_path": "/tmp/x.ts", "new_string": "// bump counter\ni++;", "old_string": "i++;"}}, "block"),
    ("git status ok", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "git status"}}, "allow"),
    ("git push -> gt submit", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "git push -u origin HEAD"}}, "deny", "prefer_graphite"),
    ("git commit -> gt", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "git commit -m x"}}, "deny", "prefer_graphite"),
    ("git switch -> gt checkout", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "git switch main"}}, "deny", "prefer_graphite"),
    ("git branch -m -> gt rename", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "git branch -m newname"}}, "deny", "prefer_graphite"),
    ("git branch -d ok", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "git branch -d old"}}, "allow"),
    ("git checkout file ok", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "git checkout -- src/x.ts"}}, "allow"),
    ("gh pr merge blocked", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "gh pr merge 12"}}, "deny", "prefer_graphite"),
    ("rm -rf /* -> deny", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "rm -rf /*"}}, "deny"),
    ("rm -fr / -> deny", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "rm -fr /"}}, "deny"),
    ("rm -r -f ~ -> deny", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "rm -r -f ~"}}, "deny"),
    ("rm -rf quoted $HOME -> deny", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "rm -rf \"$HOME\""}}, "deny"),
    ("sh -c wipe -> deny", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "sh -c 'rm -rf /'"}}, "deny"),
    ("chmod -R 000 / -> deny", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "chmod -R 000 /"}}, "deny"),
    ("redirect over /dev/sda -> deny", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "cat x > /dev/sda"}}, "deny"),
    ("rm -rf ./build ok", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "rm -rf ./build"}}, "allow"),
    ("rm -rf /tmp/foo ok", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "rm -rf /tmp/foo"}}, "allow"),
    ("echo of a wipe string ok", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "echo 'rm -rf /' > notes.txt"}}, "allow"),
    ("govctl stop -> ask", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "bin/govctl stop"}}, "ask"),
    ("govctl hooks-sync -> ask", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "bin/govctl hooks-sync"}}, "ask"),
    ("govctl profiles-sync -> ask", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "bin/govctl profiles-sync"}}, "ask"),
    ("edit server registry -> ask", {"agent": "t", "event": "pre_tool_use", "tool": "file_edit",
                                     "input": {"file_path": os.path.join(ROOT, "profiles", "servers.local.json"), "old_string": "a", "new_string": "b"}}, "ask"),
    ("govctl status ok", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "bin/govctl status"}}, "allow"),
    ("repoint port file -> ask", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "echo 1 > ~/.govd/port"}}, "ask"),
    ("read audit log ok", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "tail -n 5 ~/.govd/audit.jsonl"}}, "allow"),
    ("kill daemon -> ask", {"agent": "t", "event": "pre_tool_use", "tool": "shell", "input": {"command": "kill $(cat ~/.govd/govd.pid)"}}, "ask"),
    ("edit adapter -> ask", {"agent": "t", "event": "pre_tool_use", "tool": "file_edit",
                             "input": {"file_path": os.path.join(ROOT, "adapters", "claude_code.py"), "old_string": "a", "new_string": "b"}}, "ask"),
    ("edit hook config -> ask", {"agent": "t", "event": "pre_tool_use", "tool": "file_edit",
                                 "input": {"file_path": os.path.expanduser("~/.claude/settings.json"), "old_string": "a", "new_string": "b"}}, "ask"),
    ("disableAllHooks -> ask", {"agent": "t", "event": "pre_tool_use", "tool": "file_edit",
                                "input": {"file_path": "/tmp/proj/.claude/settings.local.json", "content": "{\"disableAllHooks\": true}"}}, "ask"),
    ("edit skill ok", {"agent": "t", "event": "pre_tool_use", "tool": "file_edit",
