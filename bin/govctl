    from instrsync.sync import main as _instr_main
    return _instr_main(["list"] + args)


def instructions_show(args):
    from instrsync.sync import main as _instr_main
    return _instr_main(["show"] + args)


def profiles_sync(args):
    from profilesync.sync import main as _profiles_main
    return _profiles_main(["sync"] + args)


def profiles_list(args):
    from profilesync.sync import main as _profiles_main
    return _profiles_main(["list"] + args)


