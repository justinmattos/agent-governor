]


def reap(args):
    from govd import config
    from govd.reaper import reap as _reap
    dry = "--dry-run" in args
    config.ensure_home()
    groups = _reap(dry_run=dry)
    verb = "would stop" if dry else "stopped"
    for g in groups:
        rss = sum(p.rss for p in g) / 1024
        print(_clean(f"  {verb} pid {g[0].pid} (+{len(g) - 1} child), {rss:.0f} MB, "
                     f"up {g[0].age // 3600}h: {g[0].command[:80]}"))
    total = sum(p.rss for g in groups for p in g) / 1024
    print(f"{len(groups)} orphan group(s) {verb}, {total:.0f} MB; patterns: {', '.join(config.REAP_PATTERNS) or '(none)'}")
    return 0


def _startup_tokens(extra):
    proc = subprocess.run(
        ["claude", "-p", "Reply with just OK.", "--output-format", "json"] + extra,
        capture_output=True, text=True, timeout=300,
    )
    u = json.loads(proc.stdout).get("usage", {})
    return u.get("input_tokens", 0) + u.get("cache_read_input_tokens", 0) + u.get("cache_creation_input_tokens", 0)


def mcp_cost(args):
    """Startup prompt tokens per user-scope MCP server, measured with headless Claude runs.

    Each server is run alone under --strict-mcp-config and compared with a run that has
    none. What remains of the everything-connected run is claude.ai connectors and
    plugin servers, which can't be connected one at a time.
    """
    from govd import config
    with open(os.path.expanduser("~/.claude.json")) as fh:
        servers = json.load(fh).get("mcpServers") or {}
    names = args or sorted(servers)
    unknown = [n for n in names if n not in servers]
    if unknown:
        print("not a user-scope server in ~/.claude.json:", ", ".join(unknown), file=sys.stderr)
        return 2
    config.ensure_home()
    tmp = os.path.join(config.GOVD_HOME, f"mcp-cost-{os.getpid()}.json")

    def strict(mcp):
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            json.dump({"mcpServers": mcp}, fh)
        return _startup_tokens(["--strict-mcp-config", "--mcp-config", tmp])

    try:
        full = _startup_tokens([])
        base = strict({})
        print(f"{'everything connected':32} {full:>7}")
        print(f"{'no MCP servers':32} {base:>7}")
        total = 0
        for n in names:
            delta = strict({n: servers[n]}) - base
            total += delta
            print(f"{'  + ' + n:32} {delta:>+7}")
        if not args:
            print(f"{'  + connectors and plugins':32} {full - base - total:>+7}")
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    return 0


def _reaper_selftest():
    """Orphan a marked sleeper and keep a parented one; only the orphan may be reaped."""
    from govd.reaper import reap as _reap
    marker = f"govd-reap-selftest-{os.getpid()}"
    sleeper = [sys.executable, "-c", "import time; time.sleep(60)", marker]
    parented = subprocess.Popen(sleeper)
    subprocess.run(["sh", "-c", " ".join(f"'{a}'" for a in sleeper) + " >/dev/null 2>&1 &"])
    time.sleep(0.5)
    try:
        reaped = {p.pid for g in _reap(patterns=[marker], grace=0) for p in g}
        left = subprocess.run(["pgrep", "-f", marker], capture_output=True, text=True).stdout.split()
        return bool(reaped) and left == [str(parented.pid)] and parented.poll() is None
    finally:
        parented.kill()
        parented.wait()


def selftest(_):
    if not _health():
        print("govd not running; start it first", file=sys.stderr)
        return 1
    import shutil
    import tempfile
    disabled = tempfile.NamedTemporaryFile("w", suffix=".settings.json", delete=False)
    disabled.write('{"disableAllHooks": true}')
    disabled.close()

    # A plan is recorded on each edit and validated once at Stop. Lay down a
    # malformed and a conforming plan in real .context/plans dirs so the stop
    # event can read them from disk.
    plan_ok = (
        "## Summary\nSwap a manual post-release step for an automatic one so nobody has to remember it.\n\n"
        "## Today\nSomeone runs the cleanup by hand after each release, and it is often forgotten, leaving stale data around.\n\n"
        "## After\nThe cleanup runs on its own once a release finishes, so stale data never lingers and no one has to remember it.\n\n"
        "## Changes\n- Run the cleanup automatically once a release finishes. [K1]\n\n"
        "## Appendix\n- [K1] `scripts/cleanup.sh` — the cleanup this triggers automatically\n"
    )
    plan_root = tempfile.mkdtemp()
    bad_ws = os.path.join(plan_root, "bad")
    ok_ws = os.path.join(plan_root, "ok")
    os.makedirs(os.path.join(bad_ws, ".context", "plans"))
    os.makedirs(os.path.join(ok_ws, ".context", "plans"))
    bad_plan = os.path.join(bad_ws, ".context", "plans", "p.md")
    ok_plan = os.path.join(ok_ws, ".context", "plans", "p.md")
    with open(bad_plan, "w") as fh:
        fh.write("## Summary\n\nstub\n")
    with open(ok_plan, "w") as fh:
        fh.write(plan_ok)

    samples = SAMPLES + [
        ("disableAllHooks config change -> block",
         {"agent": "t", "event": "config_change", "tool": None,
          "input": {"source": "local_settings", "file_path": disabled.name}}, "block"),
        ("plan edit recorded, not blocked",
         {"agent": "t", "event": "post_tool_use", "tool": "file_edit",
          "input": {"file_path": bad_plan}, "session_id": "selftest-planbad", "cwd": bad_ws}, "allow"),
        ("stop with malformed plan -> block",
         {"agent": "t", "event": "stop", "tool": None, "input": {},
          "session_id": "selftest-planbad", "cwd": bad_ws}, "block", "plan_format"),
        ("conforming plan edit recorded",
         {"agent": "t", "event": "post_tool_use", "tool": "file_edit",
          "input": {"file_path": ok_plan}, "session_id": "selftest-planok", "cwd": ok_ws}, "allow"),
        ("stop with conforming plan -> allow",
         {"agent": "t", "event": "stop", "tool": None, "input": {},
          "session_id": "selftest-planok", "cwd": ok_ws}, "allow"),
        ("ExitPlanMode malformed proposal -> deny",
         {"agent": "t", "event": "pre_tool_use", "tool": "plan", "input": {"plan": "## Context\n\nstub only"}}, "deny", "plan_format"),
        ("ExitPlanMode conforming proposal -> allow",
         {"agent": "t", "event": "pre_tool_use", "tool": "plan", "input": {"plan": plan_ok}}, "allow"),
    ]
    loaded = set((_health() or {}).get("rules") or [])
    ok = True
    for sample in samples:
        name, payload, expect = sample[0], sample[1], sample[2]
        rule = sample[3] if len(sample) > 3 else None
        if rule and rule not in loaded:
            # A personal rule this sample exercises is not installed here (e.g. a fresh
            # clone or CI). Skip rather than fail — the shared rules still gate.
            print(f"  SKIP  {name}: rule '{rule}' not loaded")
            continue
        payload.setdefault("session_id", "selftest")
        payload.setdefault("cwd", "/tmp")
        data = json.dumps(payload).encode()
        req = urllib.request.Request(f"http://127.0.0.1:{_port()}/v1/evaluate", data=data,
                                     headers={"Content-Type": "application/json"})
        got = json.loads(urllib.request.urlopen(req, timeout=2).read())["decision"]
        mark = "PASS" if got == expect else "FAIL"
        ok = ok and got == expect
        print(f"  {mark}  {name}: expected {expect}, got {got}")
    try:
        urllib.request.urlopen(urllib.request.Request(f"http://127.0.0.1:{_port()}/v1/evaluate", data=b"{}",
                                                      headers={"Content-Type": "text/plain"}), timeout=2)
        got = "accepted"
    except urllib.error.HTTPError as exc:
        got = str(exc.code)
    ok = ok and got == "415"
    print(f"  {'PASS' if got == '415' else 'FAIL'}  non-JSON content type rejected: expected 415, got {got}")
    from instrsync.sync import render
    expected = render("cursor")
    proc = subprocess.run(
        [sys.executable, os.path.join(ROOT, "adapters", "cursor.py")],
        input=json.dumps({"hook_event_name": "sessionStart", "conversation_id": "selftest", "workspace_roots": ["/tmp"]}),
        capture_output=True, text=True, timeout=10,
    )
    got = (json.loads(proc.stdout) if proc.stdout.strip() else {}).get("additional_context", "")
    ok = ok and got == expected
    print(f"  {'PASS' if got == expected else 'FAIL'}  cursor sessionStart injects instructions: expected {len(expected)} bytes, got {len(got)}")
    for sid in ("selftest", "selftest-planbad", "selftest-planok"):
        urllib.request.urlopen(urllib.request.Request(f"http://127.0.0.1:{_port()}/v1/evaluate",
                                                      data=json.dumps({"event": "session_end", "session_id": sid}).encode(),
                                                      headers={"Content-Type": "application/json"}), timeout=2)
    reaped_ok = _reaper_selftest()
    ok = ok and reaped_ok
    print(f"  {'PASS' if reaped_ok else 'FAIL'}  reaper stops an orphaned MCP-like process and spares a parented one")
    os.unlink(disabled.name)
    shutil.rmtree(plan_root, ignore_errors=True)
    return 0 if ok else 1


PLIST_TEMPLATE = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{label}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{python}</string>
    <string>{server}</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>{out}</string>
  <key>StandardErrorPath</key><string>{out}</string>
</dict>
</plist>
"""


def install_agent(_):
    os.makedirs(os.path.dirname(PLIST), exist_ok=True)
    os.makedirs(HOME, exist_ok=True)
    with open(PLIST, "w") as fh:
        fh.write(PLIST_TEMPLATE.format(label=LABEL, python=sys.executable, server=SERVER, out=OUT_LOG))
    subprocess.run(["launchctl", "unload", PLIST], capture_output=True)
    r = subprocess.run(["launchctl", "load", PLIST], capture_output=True, text=True)
    if r.returncode != 0:
        print("launchctl load failed:", r.stderr, file=sys.stderr)
        return 1
    for _ in range(20):
        time.sleep(0.2)
        if _health():
            print("LaunchAgent installed and govd running on port", _port())
            return 0
    print("LaunchAgent installed but govd not yet healthy; check", OUT_LOG, file=sys.stderr)
    return 1


def uninstall_agent(_):
    if os.path.exists(PLIST):
        subprocess.run(["launchctl", "unload", PLIST], capture_output=True)
        os.remove(PLIST)
        print("LaunchAgent removed")
    else:
        print("LaunchAgent not installed")
    return 0


def skills_sync(args):
    from skillsync.sync import main as _skills_main
    return _skills_main(["sync"] + args)


def skills_list(args):
    from skillsync.sync import main as _skills_main
    return _skills_main(["list"] + args)


