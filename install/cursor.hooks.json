      { "command": "{python} {governor_root}/adapters/cursor.py" }
    ],
    "beforeShellExecution": [
      { "command": "{python} {governor_root}/adapters/cursor.py" }
    ],
    "afterShellExecution": [
      { "command": "{python} {governor_root}/adapters/cursor.py" }
    ],
